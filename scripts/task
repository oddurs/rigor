#!/bin/sh
# The single seam between this project and all of its automation.
#
# CI, the git hooks and scripts/agent only ever call these targets, so nothing
# outside this file knows the project is written in Rust. Change toolchains by
# editing this file; nothing else needs to move.
set -eu

usage() {
	cat >&2 <<'USAGE'
usage: scripts/task <target>

targets:
  fmt        format in place
  fmt:check  verify formatting, non-zero on drift
  lint       lint; warnings are errors (clippy, shellcheck, site types)
  test       full test suite: unit, property, snapshot, end-to-end, hooks
  build      compile all targets, and verify the site's CSS
  check      fmt:check && lint && test && build

  coverage   line coverage report (not part of check)
  test:live  contract tests against the real GitHub API (needs gh auth)

Covers both the Rust CLI and the site in site/.
USAGE
	exit 2
}

# The pinned toolchain in rust-toolchain.toml is installed on demand by rustup.
CARGO="${CARGO:-cargo}"

# Tools beyond cargo are required, not optional: a check that silently skips
# when a tool is missing is a check that stops running without anyone noticing.
need() {
	if ! command -v "$1" >/dev/null 2>&1; then
		printf '%s is not installed. %s\n' "$1" "$2" >&2
		exit 1
	fi
}

SHELL_SCRIPTS="scripts/task scripts/setup scripts/agent .githooks/commit-msg .githooks/pre-commit .githooks/pre-push"

# The site is a second stack behind the same seam. Its dependencies are not
# optional: skipping them silently would let the site rot while `check` stayed
# green, so a missing install is a loud failure with the command to fix it.
site() {
	if [ ! -d site/node_modules ]; then
		printf 'site/node_modules is missing. run: scripts/setup\n' >&2
		printf '  (or, just for the site: cd site && pnpm install)\n' >&2
		exit 1
	fi
	(cd site && pnpm run --silent "$@")
}

case "${1:-}" in
fmt)
	"$CARGO" fmt --all
	site fmt
	;;
fmt:check)
	"$CARGO" fmt --all -- --check
	site fmt:check
	;;
lint)
	"$CARGO" clippy --all-targets --all-features --locked -- -D warnings
	need shellcheck "Install: brew install shellcheck (or apt-get install shellcheck)"
	# shellcheck disable=SC2086 # the list is split on purpose
	shellcheck $SHELL_SCRIPTS
	site typecheck
	;;
test)
	# nextest: each test in its own process, and a hung end-to-end test is
	# killed (see .config/nextest.toml) instead of stalling the run. CI sets
	# NEXTEST_PROFILE=ci, which also writes JUnit.
	need cargo-nextest "Install: brew install cargo-nextest (or cargo install cargo-nextest --locked)"
	"$CARGO" nextest run --all-features --locked
	# The site's behavior is its build output; build verifies it.
	;;
build)
	"$CARGO" build --all-targets --locked
	site build
	# A green `next build` has shipped an unstyled page before.
	site check:css
	;;
coverage)
	need cargo-llvm-cov "Install: brew install cargo-llvm-cov (or cargo install cargo-llvm-cov --locked)"
	need cargo-nextest "Install: brew install cargo-nextest"
	# Coverage needs LLVM's profiling tools for the pinned toolchain.
	rustup component add llvm-tools-preview >/dev/null
	"$CARGO" llvm-cov nextest --all-features --locked --html
	"$CARGO" llvm-cov report --summary-only
	printf '\nHTML report: target/llvm-cov/html/index.html\n'
	;;
test:live)
	# The contract with GitHub's real API. Needs the network and gh auth, so
	# it is not part of check; CI runs it weekly (.github/workflows/contract.yml).
	need cargo-nextest "Install: brew install cargo-nextest"
	"$CARGO" nextest run --all-features --locked --run-ignored only -E 'test(/^github::tests::live_/)'
	;;
check)
	# Ordered cheapest-first so the fastest signal fails first.
	"$0" fmt:check
	"$0" lint
	"$0" test
	"$0" build
	;;
*)
	usage
	;;
esac
