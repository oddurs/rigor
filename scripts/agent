#!/bin/sh
# One unit of work -> one worktree -> one branch -> one pull request.
#
# Every subcommand is idempotent, says what it is about to do, and fails with a
# non-zero exit and an actionable message. Nothing here is stack-specific: all
# building and testing goes through scripts/task.
set -eu

BRANCH_RE='^(feat|fix|chore|docs|perf|refactor|test)/[a-z0-9][a-z0-9._-]*$'

die() {
	printf 'agent: %s\n' "$1" >&2
	exit 1
}
say() { printf '\033[36m→\033[0m %s\n' "$1"; }
ok() { printf '\033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '\033[33m!\033[0m %s\n' "$1"; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die 'not inside a git repository'; }

# The primary checkout is the first entry git reports; worktrees follow it.
primary() { git worktree list --porcelain | sed -n '1s/^worktree //p'; }

# POSIX sh has no local variables, so helpers use names no caller shares.
repo_name() {
	_rn_primary=$(primary)
	basename "$_rn_primary"
}

worktree_root() {
	_wr_primary=$(primary)
	_wr_parent=$(dirname "$_wr_primary")
	_wr_name=$(basename "$_wr_primary")
	printf '%s/.worktrees/%s' "$_wr_parent" "$_wr_name"
}

# Resolved, never hardcoded: origin/HEAD, then gh, then main.
default_branch() {
	ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || ref=''
	if [ -n "$ref" ]; then
		printf '%s' "${ref#origin/}"
		return
	fi
	gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || printf 'main'
}

# The attribution pattern, shared with the commit-msg hook and the release
# workflow so the three can never disagree.
ATTRIBUTION="$(dirname "$0")/../.githooks/attribution.ere"

strip_attribution() {
	# Any assistant attribution is removed before it reaches the GitHub API.
	# grep exits 1 when every line was removed, which is fine; 2 means the
	# pattern could not be read, which must not silently skip the strip.
	grep -Eiv -f "$ATTRIBUTION" || [ $? -eq 1 ]
}

cmd_doctor() {
	problems=0
	report() {
		warn "$1"
		problems=$((problems + 1))
	}

	say 'checking the development environment'

	if command -v git >/dev/null 2>&1; then
		version=$(git --version | awk '{print $3}')
		ok "git $version"
	else
		report 'git is not installed'
	fi
	if command -v gh >/dev/null 2>&1; then
		version=$(gh --version | head -n1 | awk '{print $3}')
		ok "gh $version"
		if gh auth status >/dev/null 2>&1; then
			login=$(gh api user -q .login 2>/dev/null) || login=unknown
			ok "gh authenticated as $login"
		else
			report 'gh is not authenticated; run: gh auth login'
		fi
	else
		report 'gh is not installed; see https://cli.github.com'
	fi

	if command -v cargo >/dev/null 2>&1; then
		version=$(cargo --version | awk '{print $2}')
		ok "cargo $version"
	else
		report 'cargo is not on PATH; install rustup from https://rustup.rs'
	fi

	# Required by scripts/task: test runs under nextest; lint runs shellcheck,
	# typos and actionlint; audit runs cargo-deny.
	if command -v cargo-nextest >/dev/null 2>&1; then
		version=$(cargo-nextest nextest --version 2>/dev/null | awk 'NR==1{print $2}')
		ok "cargo-nextest $version"
	else
		report 'cargo-nextest is missing; brew install cargo-nextest (or cargo install cargo-nextest --locked)'
	fi
	if command -v shellcheck >/dev/null 2>&1; then
		version=$(shellcheck --version | awk '/^version/{print $2}')
		ok "shellcheck $version"
	else
		report 'shellcheck is missing; brew install shellcheck (or apt-get install shellcheck)'
	fi
	if command -v typos >/dev/null 2>&1; then
		version=$(typos --version | awk '{print $2}')
		ok "typos $version"
	else
		report 'typos is missing; brew install typos-cli (or cargo install typos-cli --locked)'
	fi
	if command -v actionlint >/dev/null 2>&1; then
		version=$(actionlint --version | head -n1)
		ok "actionlint $version"
	else
		report 'actionlint is missing; brew install actionlint (see github.com/rhysd/actionlint)'
	fi
	if command -v cargo-deny >/dev/null 2>&1; then
		version=$(cargo-deny --version | awk '{print $2}')
		ok "cargo-deny $version"
	else
		report 'cargo-deny is missing; brew install cargo-deny (or cargo install cargo-deny --locked)'
	fi

	hooks=$(git config --get core.hooksPath 2>/dev/null) || hooks=''
	if [ "$hooks" = '.githooks' ]; then
		ok 'hooks path is .githooks'
	else
		say 'setting core.hooksPath to .githooks'
		git config core.hooksPath .githooks
		chmod +x .githooks/commit-msg .githooks/pre-commit .githooks/pre-push
		ok 'hooks path set'
	fi

	for h in commit-msg pre-commit pre-push; do
		[ -x ".githooks/$h" ] || report ".githooks/$h is missing or not executable"
	done

	for t in fmt fmt:check lint test build check; do
		grep -q "^${t})" scripts/task 2>/dev/null || report "scripts/task is missing the $t target"
	done

	# --porcelain, not `git diff`: untracked files are uncommitted work too.
	dirty=$(git status --porcelain | wc -l | tr -d ' ')
	if [ "$dirty" = '0' ]; then
		ok 'working tree is clean'
	else
		report "working tree has $dirty uncommitted or untracked path(s)"
	fi

	if [ "$problems" -eq 0 ]; then
		ok 'doctor: no problems found'
	else
		die "doctor found $problems problem(s) above"
	fi
}

cmd_start() {
	branch=${1:-}
	[ -n "$branch" ] || die 'usage: scripts/agent start <type>/<slug>'
	printf '%s' "$branch" | grep -Eq "$BRANCH_RE" ||
		die "branch name must match $BRANCH_RE (e.g. feat/ready-view)"

	base=$(default_branch)
	dir="$(worktree_root)/$branch"

	# Written as `if`, not `test && die`: under `set -e` a false AND-list exits
	# the script with no message at all.
	if git show-ref --quiet --verify "refs/heads/$branch"; then
		die "branch $branch already exists; one branch has exactly one worktree"
	fi
	if [ -e "$dir" ]; then
		die "$dir already exists"
	fi

	say "fetching origin"
	git fetch --quiet origin
	say "creating $branch from origin/$base"
	mkdir -p "$(dirname "$dir")"
	git worktree add --quiet -b "$branch" "$dir" "origin/$base"
	ok "worktree ready"
	printf '\n  cd %s\n\n' "$dir"
}

cmd_check() { scripts/task check; }

cmd_commit() {
	all=''
	if [ "${1:-}" = '-a' ] || [ "${1:-}" = '--all' ]; then
		all='yes'
		shift
	fi
	[ "$#" -gt 0 ] || die 'usage: scripts/agent commit [-a] <message>'
	msg="$*"

	# The commit-msg hook is the authority; fail early with the same rule so the
	# error arrives before the editor and the checks do.
	printf '%s' "$msg" | grep -Eq '^(feat|fix|chore|docs|perf|refactor|test|build|ci|style)(\([a-z0-9._/-]+\))?!?: .+' ||
		die "message is not a Conventional Commit: $msg"

	if [ -n "$all" ]; then
		say 'staging all tracked changes'
		git add -u
	fi

	# `git commit` with an empty index prints advice and exits non-zero; say
	# what to do about it instead of letting that scroll past.
	if git diff --cached --quiet; then
		die 'nothing staged. stage the change first:
    git add -A                       (everything, including new files)
    git add <path>...                (a specific set)
    scripts/agent commit -a "<msg>"  (all tracked modifications)'
	fi

	say 'committing'
	git commit -m "$msg"
}

cmd_pr() {
	draft=''
	if [ "${1:-}" = '--draft' ]; then
		draft='--draft'
	fi

	branch=$(git rev-parse --abbrev-ref HEAD)
	base=$(default_branch)
	if [ "$branch" = "$base" ]; then
		die "refusing to open a pull request from $base"
	fi

	# Only an OPEN pull request means there is nothing to do. `gh pr view`
	# matches by branch name and will happily return a closed or merged one.
	state=$(gh pr view --json state -q .state 2>/dev/null) || state=NONE
	if [ "$state" = 'OPEN' ]; then
		url=$(gh pr view --json url -q .url)
		ok "a pull request is already open: $url"
		return 0
	fi

	say 'scripts/task check'
	scripts/task check

	say "pushing $branch"
	git push -u origin "$branch"

	body=$(mktemp)
	trap 'rm -f "$body"' EXIT
	{
		printf '## Commits\n\n'
		git log "origin/$base..HEAD" --format='- %s'
		printf '\n'
		if [ -f .github/PULL_REQUEST_TEMPLATE.md ]; then
			cat .github/PULL_REQUEST_TEMPLATE.md
		fi
	} | strip_attribution >"$body"

	# One commit: use its subject. Several: derive from the branch, which is
	# more descriptive than whichever commit happened to be first.
	commits=$(git rev-list --count "origin/$base..HEAD")
	if [ "$commits" = '1' ]; then
		title=$(git log -1 --format='%s')
	else
		# '_-' not '-_': BSD tr reads a leading dash as an option flag.
		title="${branch%%/*}: $(printf '%s' "${branch#*/}" | tr '_-' '  ')"
	fi
	say 'opening the pull request'
	gh pr create --base "$base" --head "$branch" --title "$title" --body-file "$body" ${draft:+"$draft"}
	gh pr view --json url -q .url
}

cmd_sync() {
	base=$(default_branch)
	say "fetching origin and rebasing onto origin/$base"
	git fetch --quiet origin
	git rebase "origin/$base"
	ok "rebased onto origin/$base"
}

cmd_done() {
	branch=${1:-$(git rev-parse --abbrev-ref HEAD)}
	base=$(default_branch)
	if [ "$branch" = "$base" ]; then
		die "refusing to remove the $base worktree"
	fi

	dir=$(git worktree list --porcelain |
		awk -v b="refs/heads/$branch" '/^worktree /{w=substr($0,10)} /^branch /{if ($2==b) print w}')
	[ -n "$dir" ] || die "no worktree is checked out on $branch"

	here=$(pwd -P)
	main_checkout=$(primary)
	case "$here" in
	"$dir" | "$dir"/*)
		die "run this from the primary checkout, not the worktree being removed:
    cd $main_checkout && scripts/agent done $branch"
		;;
	*) ;;
	esac

	state=$(gh pr view "$branch" --json state -q .state 2>/dev/null || echo NONE)
	[ "$state" = 'MERGED' ] ||
		die "pull request for $branch is $state, not MERGED; merge it before cleaning up"

	say "removing worktree $dir"
	git worktree remove "$dir"
	say "deleting local branch $branch"
	git branch -D "$branch"
	git worktree prune
	git fetch --quiet --prune origin
	ok "$branch cleaned up"
}

cmd_list() {
	base=$(default_branch)
	git worktree list --porcelain |
		awk '/^worktree /{w=substr($0,10)} /^branch /{print substr($2,12)"\t"w} /^detached/{print "(detached)\t"w}' |
		while IFS="$(printf '\t')" read -r branch dir; do
			if [ "$branch" = "$base" ] || [ "$branch" = '(detached)' ]; then
				state='-'
			else
				state=$(gh pr view "$branch" --json state -q .state 2>/dev/null || echo 'no PR')
			fi
			printf '%-38s %-10s %s\n' "$branch" "$state" "$dir"
		done
}

case "${1:-}" in
doctor) shift && cmd_doctor "$@" ;;
start) shift && cmd_start "$@" ;;
check) shift && cmd_check "$@" ;;
commit) shift && cmd_commit "$@" ;;
pr) shift && cmd_pr "$@" ;;
sync) shift && cmd_sync "$@" ;;
done) shift && cmd_done "$@" ;;
list) shift && cmd_list "$@" ;;
*)
	cat >&2 <<'USAGE'
usage: scripts/agent <command>

  doctor                 verify the environment and wire git hooks
  start <type>/<slug>    branch from origin/<default> in a fresh worktree
  check                  scripts/task check
  commit [-a] <message>  commit with a validated Conventional Commit message
  pr [--draft]           check, push, open the pull request
  sync                   rebase the current branch onto origin/<default>
  done [branch]          confirm merged, then remove the worktree and branch
  list                   worktrees with their branches and PR state
USAGE
	exit 2
	;;
esac
