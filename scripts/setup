#!/bin/sh
# Run once after cloning. Idempotent.
set -eu

cd "$(git rev-parse --show-toplevel)"

printf 'wiring git hooks -> .githooks\n'
git config core.hooksPath .githooks
chmod +x .githooks/* 2>/dev/null || true

printf 'installing toolchain components from rust-toolchain.toml\n'
if command -v rustup >/dev/null 2>&1; then
	rustup show >/dev/null
else
	printf 'rustup not found: install from https://rustup.rs and re-run\n' >&2
	exit 1
fi

printf 'checking test tools\n'
missing=''
for tool in cargo-nextest shellcheck; do
	command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
	printf 'missing:%s\n  macOS: brew install%s\n  Linux: cargo install cargo-nextest --locked; apt-get install shellcheck\n' "$missing" "$missing" >&2
	exit 1
fi

printf 'installing site dependencies\n'
if command -v pnpm >/dev/null 2>&1; then
	(cd site && pnpm install --frozen-lockfile)
else
	printf 'pnpm not found: install Node 22+, run: corepack enable pnpm, then re-run\n' >&2
	exit 1
fi

printf 'verifying the project builds green\n'
scripts/task check

printf '\nready. next: scripts/agent start <type>/<slug>\n'
